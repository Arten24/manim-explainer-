      "manual_end": null
    },
    {
      "id": "cue-008",
      "scene_id": "journey",
      "sequence": 8,
      "text": "The name score is the same in the code and in the table; only the representation changes.",
      "start_time": 41.6,
      "end_time": 48.1,
      "event_ids": [
        "ev-code-to-memory"
      ],
      "visual_cue": null,
      "speaker": null,
