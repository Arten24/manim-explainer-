    {
      "id": "cue-002",
      "scene_id": "journey",
      "sequence": 2,
      "text": "We start with a simple picture: a box labeled score that currently holds ten.",
      "start_time": 5.88,
      "end_time": 11.76,
      "event_ids": [
        "ev-title-to-model"
      ],
      "visual_cue": null,
      "speaker": null,
