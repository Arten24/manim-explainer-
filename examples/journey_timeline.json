      "manual_start": null,
      "manual_end": null
    },
    {
      "id": "cue-003",
      "scene_id": "journey",
      "sequence": 3,
      "text": "That picture is useful, but it is not how the computer actually sees the assignment.",
      "start_time": 11.76,
      "end_time": 18.04,
      "event_ids": [
        "ev-write-heading",
        "ev-mark-card"
      ],
      "visual_cue": null,
      "speaker": null,
      "timing_status": "estimated",
      "manual_start": null,
      "manual_end": null
    },
    {
      "id": "cue-004",
      "scene_id": "journey",
      "sequence": 4,
      "text": "In source code, the same idea is written as score equals ten.",
      "start_time": 18.04,
      "end_time": 23.12,
      "event_ids": [
        "ev-example-to-code"
      ],
      "visual_cue": null,
      "speaker": null,
      "timing_status": "estimated",
      "manual_start": null,
      "manual_end": null
    },
    {
      "id": "cue-005",
      "scene_id": "journey",
      "sequence": 5,
      "text": "The identifier on the left is the name we chose; the number on the right is the value we stored.",
      "start_time": 23.12,
      "end_time": 29.62,
      "event_ids": [
        "ev-example-to-code"
      ],
      "visual_cue": null,
      "speaker": null,
      "timing_status": "estimated",
      "manual_start": null,
      "manual_end": null
    },
    {
      "id": "cue-006",
      "scene_id": "journey",
      "sequence": 6,
      "text": "When this line runs, the language runtime looks up that name in memory.",
      "start_time": 29.62,
      "end_time": 35.1,
      "event_ids": [],
      "visual_cue": null,
      "speaker": null,
      "timing_status": "estimated",
      "manual_start": null,
      "manual_end": null
    },
    {
      "id": "cue-007",
      "scene_id": "journey",
      "sequence": 7,
      "text": "Memory is just a table of slots: an address, a name, and the value that lives there.",
      "start_time": 35.1,
      "end_time": 41.6,
      "event_ids": [
