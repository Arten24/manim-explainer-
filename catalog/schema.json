{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quonitron.dev/schemas/catalog-v1.json",
  "title": "QUONITRON Master Animation Catalog",
  "description": "Versioned searchable index of reusable Manim components.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "library_version", "components"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Catalog JSON Schema version. Bump only with an explicit schema change."
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "library_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated": { "type": "string" },
    "notes": { "type": "string" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "default": true,
        "required": { "type": "boolean" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": { "type": "array" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "category",
        "subcategory",
        "tags",
        "aliases",
        "description",
        "use_cases",
        "module",
        "parameters",
        "dependencies",
        "compatibility",
        "example",
        "test_status",
        "limitations",
        "related_components",
        "license"
      ],
      "anyOf": [
        { "required": ["class_name"] },
        { "required": ["function_name"] }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "description": { "type": "string", "minLength": 1 },
        "use_cases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "module": { "type": "string", "minLength": 1 },
        "class_name": { "type": "string", "minLength": 1 },
        "function_name": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "example": { "type": "string" },
        "preview": { "type": ["string", "null"] },
        "test_status": {
          "type": "string",
          "enum": ["not_tested", "passed", "failed"]
        },
        "limitations": { "type": "string" },
        "related_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
